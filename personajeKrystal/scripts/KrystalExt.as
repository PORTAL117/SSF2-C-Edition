      override public function initialize() : void
      {
         SSF2API.print("Initialized...");
         this.addEventListener(SSF2Event.CHAR_SHIELD_HIT,this.shieldEffect,{"persistent":true});
         this.addEventListener(SSF2Event.CHAR_POWER_SHIELD_HIT,this.shieldPowerEffect,{"persistent":true});
      }
      
      override public function update() : void
      {
         if(this.getState() == CState.SHIELDING || this.getState() == CState.SHIELD_DROP)
         {
            this.getStanceMC().shieldframe.gotoAndStop(Math.ceil(this.getShieldPower() * 100) + 1);
         }
         if(this.getState() == CState.SHIELD_DROP)
         {
            if(this.getStanceMC().shieldframe.alpha > 0)
            {
               this.getStanceMC().shieldframe.alpha = this.getStanceMC().shieldframe.alpha - 0.3;
               this.getStanceMC().shieldframe.scaleX = this.getStanceMC().shieldframe.scaleX - 0.35;
            }
         }
      }
      
      private function shieldEffect(param1:* = null) : *
      {
         attachEffect("shield2_hit",{
            "x":this.flipX(9),
            "y":-15,
            "scaleX":0.5,
            "scaleY":0.5
         });
      }
      
      private function shieldPowerEffect(param1:* = null) : *
      {
         attachEffect("shield2_hit",{
            "x":this.flipX(9),
            "y":-15,
            "scaleX":0.85,
            "scaleY":0.85
         });
      }
      
      public function jumpToContinue(param1:* = null) : *
      {
         this.removeEventListener(SSF2Event.GROUND_TOUCH,this.jumpToContinue);
         this.updateAttackStats({
            "allowControl":false,
            "cancelWhenAirborne":true
         });
         this.stancePlayFrame("continue");
      }
      
      public function setLandingLag(param1:Boolean) : void
      {
         if(param1)
         {
            this.removeEventListener(SSF2Event.GROUND_TOUCH,this.toLand);
            this.addEventListener(SSF2Event.GROUND_TOUCH,this.jumpToContinue);
            if(this.isOnGround())
            {
               this.jumpToContinue();
            }
         }
         else
         {
            this.removeEventListener(SSF2Event.GROUND_TOUCH,this.jumpToContinue);
            this.addEventListener(SSF2Event.GROUND_TOUCH,this.toLand);
            if(this.isOnGround())
            {
               this.toLand();
            }
         }
      }
      
      public function flipX(param1:Number) : Number
      {
         if(this.isFacingRight())
         {
            return param1;
         }
         return param1 * -1;
      }
      
